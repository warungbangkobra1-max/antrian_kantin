# ==========================================
# ANTREAN KANTIN SANTRI - ENVIRONMENT CONFIG
# ==========================================

# Port development & production (default: 3000)
PORT=3000
NODE_ENV=production

# Base URL aplikasi (Cloud Run / Domain Hosting)
# AI Studio secara otomatis menyuntikkan ini saat runtime
APP_URL="https://ais-dev-hbgscdaoocgj7xxcblyuxv-227011702077.asia-east1.run.app"

# Kredensial Keamanan Operator & Admin
# Ganti dengan sandi kuat saat deployment produksi
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin_password_change_me"
KASIR_USERNAME="kasir"
KASIR_PASSWORD="kasir_password_change_me"

# PIN Mode Kasir & Admin (4 digit)
KASIR_PIN="1234"
ADMIN_PIN="9999"

# ==========================================
# DATABASE ONLINE VERCEL (OPSIONAL)
# ==========================================
# Jika di-deploy ke Vercel dan ingin persistensi data cloud permanen,
# pasang Upstash Redis / Vercel KV di Vercel Dashboard (Storage -> Create KV):
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Atau gunakan URL Database PostgreSQL / Supabase / Neon:
DATABASE_URL=""

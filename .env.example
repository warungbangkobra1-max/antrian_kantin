# ==============================================================
# ENVIRONMENT VARIABLES: ANTREAN KANTIN SANTRI
# ==============================================================
# Aplikasi menggunakan Supabase Auth dan Supabase PostgreSQL.
# Role pengguna (ADMIN, KASIR, DAPUR, SANTRI) dikontrol langsung
# melalui tabel "profiles" di database Supabase.
# Tidak ada username, password, atau PIN yang disimpan di environment variable.

# 1. SUPABASE POSTGRESQL & SUPABASE AUTH
# Diperoleh dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 2. SERVER-SIDE SERVICE ROLE KEY (HANYA BACKEND / SERVERLESS)
# Diperoleh dari: Supabase Dashboard -> Project Settings -> API -> service_role key
# PERINGATAN: Variabel ini hanya boleh digunakan di server/backend, jangan kirim ke browser!
SUPABASE_SERVICE_ROLE_KEY=""
